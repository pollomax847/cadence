# Copie ce fichier en .env puis renseigne tes propres valeurs.
# .env est ignoré par git (voir .gitignore) — ne jamais y committer de vrais secrets.
# ./setup.sh peut générer .env automatiquement à ta place.

# ── Interface web ──────────────────────────────────────────────────────────────
WEBUI_PORT=8900
WEBUI_ALLOW_DOCKER_CONTROL=1
COMPOSE_PROJECT_NAME=cadence

# ── Musique ────────────────────────────────────────────────────────────────────
MUSIC_HOST=/mnt/Music
ITUNES_HOST=
SSD_MUSIC_HOST=
TOSHIBA_MUSIC_HOST=

# ── Plex ──────────────────────────────────────────────────────────────────────
PLEX_TOKEN=
PLEX_URL=http://localhost:32400
PLEX_CONFIG_HOST=

# ── Navidrome ─────────────────────────────────────────────────────────────────
NAVIDROME_URL=
PLAYLISTS_HOST=/mnt/MyBook/playlists

# ── Last.fm ────────────────────────────────────────────────────────────────────
LASTFM_USER=
LASTFM_API_KEY=

# ── Discogs ────────────────────────────────────────────────────────────────────
DISCOGS_USER_TOKEN=

# ── Soulseek (slskd) ───────────────────────────────────────────────────────────
SLSKD_URL=http://host.docker.internal:5032
SLSKD_API_KEY=

# ── Reconnaissance musicale (AcoustID) ─────────────────────────────────────────
ACOUSTID_API_KEY=

# ── Binaires et scripts ────────────────────────────────────────────────────────
YTDLP_BIN_HOST=
SONGREC_BIN_HOST=
SONGREC_RENAME_BIN_HOST=
AUDIO_SCRIPTS_HOST=
MUSIC_SORT_HOST=
BEETS_CONFIG_HOST=
SONGKONG_HOST=
