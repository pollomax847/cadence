{
  "size": 600,
  "overlay_alpha": 90,
  "title_size": 50,
  "subtitle_size": 28,
  "emoji_size": 120,
  "title_start_y": 310,
  "title_line_step": 60,
  "text_padding": 45,

  "title_color": [255, 255, 255, 255],
  "title_shadow_color": [0, 0, 0, 200],
  "title_stroke_width": 1,
  "subtitle_color": [245, 245, 245, 255],
  "line_color": [255, 255, 255, 110],

  "font_path": "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf",
  "emoji_font_path": "/usr/share/fonts/truetype/noto/NotoColorEmoji.ttf",

  "strip_auto_prefix": true,
  "strip_count_suffix": true,

  "add_noise": true,
  "add_pattern": true,
  "pattern_type": "dots",

  "default_emoji": "🎵",
  "default_colors": [[100, 50, 150], [200, 100, 255]],

  "themes": [
    {
      "keywords": ["summer", "hot", "energy", "fire"],
      "match": "any",
      "emoji": "🔥",
      "colors": [[200, 50, 50], [255, 150, 50]]
    },
    {
      "keywords": ["tropical", "summer", "beach"],
      "match": "any",
      "emoji": "🌴",
      "colors": [[50, 150, 200], [100, 200, 255]]
    },
    {
      "keywords": ["sunset", "evening", "dusk"],
      "match": "any",
      "emoji": "🌅",
      "colors": [[255, 100, 50], [255, 200, 100]]
    },
    {
      "keywords": ["neon", "glow", "bright"],
      "match": "any",
      "emoji": "⚡",
      "colors": [[0, 200, 255], [255, 0, 255]]
    }
  ]
}