{
  "size": 600,
  "overlay_alpha": 100,
  "title_size": 44,
  "subtitle_size": 22,
  "emoji_size": 85,
  "title_start_y": 320,
  "title_line_step": 56,
  "text_padding": 55,

  "title_color": [255, 255, 0, 255],
  "title_shadow_color": [80, 0, 80, 200],
  "title_stroke_width": 2,
  "subtitle_color": [200, 200, 255, 230],
  "line_color": [255, 200, 0, 100],

  "font_path": "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf",
  "emoji_font_path": "/usr/share/fonts/truetype/noto/NotoColorEmoji.ttf",

  "strip_auto_prefix": true,
  "strip_count_suffix": true,

  "add_noise": true,
  "add_pattern": true,
  "pattern_type": "lines",

  "default_emoji": "🎵",
  "default_colors": [[200, 50, 150], [100, 50, 200]],

  "themes": [
    {
      "keywords": ["80s", "retro", "vintage", "nostalgic"],
      "match": "any",
      "emoji": "💫",
      "colors": [[255, 100, 200], [100, 100, 255]]
    },
    {
      "keywords": ["synthwave", "retrowave", "synthpop"],
      "match": "any",
      "emoji": "🌆",
      "colors": [[255, 50, 150], [100, 150, 255]]
    },
    {
      "keywords": ["vaporwave", "aesthetic"],
      "match": "any",
      "emoji": "✨",
      "colors": [[150, 100, 200], [100, 200, 255]]
    }
  ]
}