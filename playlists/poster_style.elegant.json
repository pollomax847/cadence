{
  "size": 600,
  "overlay_alpha": 120,
  "title_size": 48,
  "subtitle_size": 26,
  "emoji_size": 100,
  "title_start_y": 300,
  "title_line_step": 55,
  "text_padding": 50,

  "title_color": [255, 255, 255, 255],
  "title_shadow_color": [0, 0, 0, 200],
  "title_stroke_width": 0,
  "subtitle_color": [220, 220, 220, 240],
  "line_color": [255, 255, 255, 100],

  "font_path": "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf",
  "emoji_font_path": "/usr/share/fonts/truetype/noto/NotoColorEmoji.ttf",

  "strip_auto_prefix": true,
  "strip_count_suffix": true,

  "add_noise": true,
  "add_pattern": true,
  "pattern_type": "dots",

  "default_emoji": "🎵",
  "default_colors": [[45, 85, 150], [100, 180, 240]],

  "themes": [
    {
      "keywords": ["stars 80", "80s"],
      "match": "any",
      "emoji": "⭐",
      "colors": [[180, 60, 180], [255, 100, 180]]
    },
    {
      "keywords": ["running", "workout", "cardio", "gym"],
      "match": "any",
      "emoji": "🏃",
      "colors": [[255, 100, 50], [255, 200, 100]]
    },
    {
      "keywords": ["chill", "lofi", "lo-fi", "relax", "concentration"],
      "match": "any",
      "emoji": "🧘",
      "colors": [[50, 120, 160], [80, 180, 200]]
    },
    {
      "keywords": ["dark", "gothic", "industrial", "aggressive"],
      "match": "any",
      "emoji": "🌑",
      "colors": [[20, 20, 40], [60, 60, 120]]
    },
    {
      "keywords": ["dream", "ethereal", "ambient", "atmospheric"],
      "match": "any",
      "emoji": "☁️",
      "colors": [[100, 80, 150], [180, 150, 220]]
    },
    {
      "keywords": ["party", "club", "dance", "fête"],
      "match": "any",
      "emoji": "🎉",
      "colors": [[220, 50, 100], [255, 150, 200]]
    },
    {
      "keywords": ["epic", "cinematic", "orchestra", "score"],
      "match": "any",
      "emoji": "🎬",
      "colors": [[180, 100, 50], [255, 180, 100]]
    },
    {
      "keywords": ["jazz", "blues", "swing"],
      "match": "any",
      "emoji": "🎷",
      "colors": [[80, 60, 140], [150, 120, 200]]
    },
    {
      "keywords": ["rock", "metal", "punk", "hardcore"],
      "match": "any",
      "emoji": "🎸",
      "colors": [[150, 50, 50], [200, 100, 80]]
    },
    {
      "keywords": ["pop", "vocal", "love", "romance"],
      "match": "any",
      "emoji": "💖",
      "colors": [[200, 80, 120], [255, 150, 180]]
    },
    {
      "keywords": ["hip-hop", "rap", "urban", "beat"],
      "match": "any",
      "emoji": "🎤",
      "colors": [[50, 50, 50], [120, 120, 120]]
    },
    {
      "keywords": ["electronic", "synth", "techno", "house"],
      "match": "any",
      "emoji": "⚡",
      "colors": [[100, 50, 150], [200, 100, 255]]
    },
    {
      "keywords": ["nature", "world", "travel", "tropical"],
      "match": "any",
      "emoji": "🌴",
      "colors": [[100, 150, 100], [150, 200, 150]]
    }
  ]
}
