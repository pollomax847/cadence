{
  "size": 1200,
  "overlay_alpha": 110,
  "title_size": 48,
  "subtitle_size": 26,
  "emoji_size": 90,
  "title_start_y": 300,
  "title_line_step": 55,
  "text_padding": 50,

  "title_color": [255, 255, 255, 255],
  "title_shadow_color": [0, 0, 0, 180],
  "title_stroke_width": 0,
  "subtitle_color": [210, 210, 210, 230],
  "line_color": [255, 255, 255, 90],

  "font_path": "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf",
  "emoji_font_path": "/usr/share/fonts/truetype/noto/NotoColorEmoji.ttf",

  "strip_auto_prefix": true,
  "strip_count_suffix": true,

  "add_noise": true,
  "add_pattern": true,
  "pattern_type": "dots",

  "default_emoji": "🎵",
  "default_colors": [[40, 85, 140], [100, 160, 220]],

  "themes": [
    {
      "keywords": ["stars 80"],
      "match": "all",
      "emoji": "⭐",
      "colors": [[140, 50, 180], [255, 100, 200]]
    },
    {
      "keywords": ["running", "workout"],
      "match": "any",
      "emoji": "🏃",
      "colors": [[255, 100, 50], [255, 200, 100]]
    },
    {
      "keywords": ["chill", "concentration", "relax"],
      "match": "any",
      "emoji": "🧘",
      "colors": [[50, 130, 170], [80, 190, 210]]
    }
  ]
}
